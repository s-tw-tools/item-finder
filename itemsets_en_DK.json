<!DOCTYPE html>
<html data-bs-theme="light">
<head>
    <title>InnoGames Account Management</title>
    <link rel="stylesheet" type="text/css" href="/bundles/public/public.css?6429cc250ba0c15be1dd9c745f357187"/>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
    <script type="text/javascript" src="/bundles/public/public.js?c9105da06eb466764c7aa10ede9fe451"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
</head>

<body class="bg7">
    <div class="login-container">
        <div class="middle-box loginscreen">
            <div class="auth-logo">
                <img src="/img/logo_innogames_straight_400.png" class="img-fluid" />
            </div>

            <h5 class="text-center auth-title">
             Login to West XX Market    </h5>

<div class="error-display" style="display: none">
    <div class="error-display alert alert-danger mt-4 p-2 d-flex align-items-center">
        <i class="fa fa-exclamation-triangle me-2"></i>
        <span class="error-msg"></span>
    </div>
</div>

<form class="mt-4" action="#" id="login_form" method="post">
            <div class="mb-3 primary-authentication">
            <input type="text" name="username" class="form-control" placeholder="Username" required autocomplete="username"
                   autofocus />
        </div>
        <div class="mb-3 primary-authentication">
            <input type="password" name="password" class="form-control" placeholder="Password" required autocomplete="current-password" />
        </div>
        <div class="mb-3 secondary-authentication" style="display: none">
            <input type="text" name="code" class="form-control" placeholder="Enter two factor code" readonly required
                   autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]{6,10}" title="Please enter your 6-10 digit numeric code." minlength="6" maxlength="10" />
        </div>
        <div class="secondary-authentication" style="display: none">
            <div class="form-check mb-3">
                <input type="checkbox" name="remember_browser" id="remember_browser" value="1" class="form-check-input" >
                <label for="remember_browser" class="form-check-label">
                    <span data-tooltip="You will not be prompted for two factor security on this browser for the next 30 days, even if your IP Address changes.">
                        Remember browser for 30 days <i class="fa fa-question-circle"></i>
                    </span>
                </label>
            </div>
        </div>
        <input type="hidden" name="session_id" />
        <input type="hidden" name="public_key" />
    
    <div class="w-100 d-flex mb-3">
        <button type="submit" class="btn btn-primary flex-grow-1 login-button" >
            Log in        </button>

                <button type="button" class="btn btn-primary key-button ms-2" data-tooltip="Log in with a security key">
            <i class="fa fa-key text-warning"></i>
        </button>
            </div>

    <div class="text-center">
            <a href="/recovery">
            <small>Forgot password?</small>
        </a>
        </div>
</form>

<script>
    $(function () {
        Login.init(false);
    });
</script>
        </div>
    </div>
</body>
</html>